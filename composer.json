{
    "name": "sinemacula/laravel-aws-sns-listener",
    "type": "library",
    "description": "Laravel package to handle AWS SNS notifications with seamless integration and event-driven architecture",
    "keywords": [
        "sine macula",
        "laravel",
        "aws",
        "sns",
        "listener",
        "events",
        "webhooks"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Ben Carey",
            "email": "bdmc@sinemacula.co.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-php-sns-message-validator": "^1.9",
        "aws/aws-sdk-php": "^3.319",
        "illuminate/http": "*",
        "illuminate/support": "*",
        "nesbot/carbon": "*"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "friendsofphp/php-cs-fixer": "3.89.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "^2.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.3",
        "sinemacula/coding-standards-laravel": "^1.4.0",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "4.0.1"
    },
    "autoload": {
        "psr-4": {
            "SineMacula\\Aws\\Sns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "qlty check"
        ],
        "format": [
            "qlty fmt"
        ],
        "smells": [
            "qlty smells"
        ],
        "test": [
            "@php vendor/bin/paratest $@"
        ],
        "test-coverage": [
            "@php vendor/bin/paratest --coverage-clover=clover.xml"
        ]
    },
    "scripts-descriptions": {
        "check": "Run static analysis and lint checks via qlty.",
        "format": "Format codebase using qlty.",
        "smells": "Report duplication and complexity smells via qlty.",
        "test": "Run the default PHPUnit test suites in parallel using Paratest.",
        "test-coverage": "Shortcut to run Paratest coverage for default suites."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SineMacula\\Aws\\Sns\\SnsServiceProvider"
            ]
        }
    }
}
